{
  "name": "@local/dsh-sticky-wall",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "左侧栏「便签墙」面板：随手记便签、按颜色区分，删除可撤销，便签保存在本机浏览器存储。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "sticky-notes",
    "notes",
    "sidebar",
    "便签"
  ],
  "license": "MIT",
  "author": "HitMargin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HitMargin/dsh-sticky-wall.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
